# Copy to .env.local and fill in with values from `pnpm exec supabase status`
# (local dev) or the Supabase project dashboard (remote). Never commit the
# filled-in file -- .env.local is gitignored.

# Browser + server Supabase client (lib/supabase/client.ts, lib/supabase/server.ts,
# lib/supabase/proxy.ts). Safe to expose to the browser -- NEXT_PUBLIC_ prefix required.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# No server-only secret/service-role key yet. One will be introduced (never with a
# NEXT_PUBLIC_ prefix) when the Beta account provisioning script and
# commit_answer_transaction()'s trusted server path are explicitly approved --
# see docs/DATABASE_SCHEMA.md section 10.3 and 10.6.
