# Copy to .env.local and fill in with values from `pnpm exec supabase status`
# (local dev) or the Supabase project dashboard (remote). Never commit the
# filled-in file -- .env.local is gitignored.
#
# Intended local development setup (Learning Engine phase onward):
#   - Ordinary `pnpm dev` must point NEXT_PUBLIC_SUPABASE_URL at LOCAL Supabase
#     (`pnpm exec supabase start`, then `pnpm exec supabase status` for the
#     values below). Remote-project credentials must never be the default
#     local-dev environment -- once SUPABASE_SERVICE_ROLE_KEY is set, ordinary
#     `pnpm dev` can execute trusted, RLS-bypassing writes (e.g.
#     commit_answer_transaction(), see docs/DATABASE_SCHEMA.md section 10.3),
#     and a remote URL there means those writes land on the deployed project.
#   - lib/supabase/service-role-guard.ts enforces this: the service-role
#     client (added in a later phase) refuses to initialize unless
#     NEXT_PUBLIC_SUPABASE_URL resolves to localhost/127.0.0.1/::1, unless
#     ALLOW_REMOTE_SUPABASE_SERVICE_ROLE is explicitly set below.
#   - This file documents variable NAMES only. Never put a real value here --
#     put it in your own gitignored .env.local instead.

# Browser + server Supabase client (lib/supabase/client.ts, lib/supabase/server.ts,
# lib/supabase/proxy.ts). Safe to expose to the browser -- NEXT_PUBLIC_ prefix required.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Required by the future service-role Supabase client
# (lib/supabase/service-role-guard.ts and a later lib/supabase/service-role.ts)
# for commit_answer_transaction(), which is service_role-only -- see
# docs/DATABASE_SCHEMA.md sections 10.3 and 10.6. Never prefix this with
# NEXT_PUBLIC_: that would inline it into the browser bundle at build time.
# For ordinary local development this must be the LOCAL Supabase project's
# service-role key (from `pnpm exec supabase status -o env`), never a
# deployed/remote project's key.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only escape hatch, off by default. Set to the literal string "true"
# only for a deliberate, one-off remote operation that must run the
# service-role client against a non-local Supabase URL. Never set this in a
# normal local-dev .env.local, and never prefix it with NEXT_PUBLIC_.
ALLOW_REMOTE_SUPABASE_SERVICE_ROLE=
